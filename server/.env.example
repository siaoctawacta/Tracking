# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of front-end origins allowed by CORS (only needed when the SPA is served from another origin)
CORS_ORIGINS=http://localhost:5173
# Set to the number of reverse proxies in front of the API (needed for correct per-IP rate limiting)
TRUST_PROXY=0

# --- Base de données PostgreSQL ---
# Développement : Postgres local (docker compose up -d, voir docker-compose.yml).
# Production (Supabase → bouton « Connect ») :
#   DATABASE_URL = « Transaction pooler » (port 6543) — utilisé par l'application
#   DIRECT_URL   = « Session pooler » (port 5432) — utilisé par les migrations
DATABASE_URL="postgresql://kader:kader@localhost:5432/kader_cargo"
DIRECT_URL=
# SSL : off | require (chiffré) | verify (chiffré + certificat vérifié avec DATABASE_CA_CERT).
# Vide = « require » automatiquement pour les hôtes Supabase, « off » sinon.
DATABASE_SSL=
DATABASE_CA_CERT=

# --- Photos : Supabase Storage (vide = disque local, dossier server/uploads) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# --- Tâche de maintenance quotidienne (Vercel Cron) ---
CRON_SECRET=

# --- Security ---
# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Forced to true when NODE_ENV=production (cookies are then __Host-jwt / __Host-rt / __Host-csrf).
# Set true locally too if you test over https://localhost.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5

# --- Site public (liens de suivi dans les messages WhatsApp) ---
PUBLIC_WEB_URL=http://localhost:5173

# --- E-mail (codes de vérification, avis de compte) ---
# Vide = e-mails simulés (affichés dans la console). Gmail : smtp.gmail.com, port 465, mot de passe d'application.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kader Cargo <no-reply@kadercargo.com>"

# --- Connexion Google (« Continuer avec Google ») ---
# ID client OAuth « Application Web » (Google Cloud Console → Identifiants), origine autorisée = URL du site.
# Le site le récupère automatiquement via /api/v1/auth/options (aucune variable côté web).
GOOGLE_CLIENT_ID=

# --- WhatsApp ---
# twilio | meta | simulated. Vide = détection automatique selon les identifiants ci-dessous ;
# sans identifiants, les messages sont simulés (journalisés et visibles dans le back-office).
WHATSAPP_PROVIDER=
# Option 1 — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Modèles approuvés (Content API) par étape, ex : {"REGISTERED":"HX...","READY":"HX...","OTP":"HX...","ACCOUNT":"HX..."}
TWILIO_CONTENT_SIDS=
# Option 2 — Meta WhatsApp Business Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Modèles nommés <prefixe><etape> : kader_registered, kader_loading, …, plus kader_otp (catégorie Authentification)
# et kader_account (avis de compte). Vide = texte libre (fenêtre 24 h).
META_TEMPLATE_PREFIX=kader_
META_TEMPLATE_LANGUAGE=fr
