// Kader Cargo — data model (PostgreSQL: Supabase in production, local Postgres for development and tests)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles: CLIENT | AGENT_GZ | AGENT_LOME | ADMIN
/// approvalStatus: PENDING (self-registered, waiting for an admin) | APPROVED | REJECTED
/// Identifiers (phone, email, googleSub) are only stored once proven (OTP, Google, or created by staff),
/// because they grant access to the parcels registered under them.
model User {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  phone               String?   @unique
  googleSub           String?   @unique
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  passwordHash        String?
  role                String    @default("CLIENT")
  active              Boolean   @default(true)
  approvalStatus      String    @default("APPROVED")
  approvedAt          DateTime?
  approvedById        String?
  signupMethod        String?
  notificationsSeenAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]
  events        ShipmentEvent[]
  shipments     Shipment[]      @relation("CreatedShipments")
  otpCodes      OtpCode[]

  @@index([approvalStatus])
}

/// One-time codes sent by WhatsApp or email.
/// purpose: REGISTER | LOGIN | LINK — only the HMAC of the code is stored.
model OtpCode {
  id          String    @id @default(cuid())
  channel     String
  destination String
  purpose     String
  codeHash    String
  /// REGISTER: pending sign-up data (name, optional password hash) as JSON
  payload     String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([destination, purpose])
}

/// Back-office notifications (bell + sound). `roles` = comma-separated audience.
/// type: ACCOUNT_PENDING | CONTAINER_DEPARTED | CONTAINER_ARRIVED | SHIPMENT_ARRIVED | WHATSAPP_FAILED
model StaffNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  link      String?
  roles     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

/// Mode: SEA | AIR — State: OPEN | CLOSED
model Container {
  id          String     @id @default(cuid())
  code        String     @unique
  mode        String
  state       String     @default("OPEN")
  departureAt DateTime?
  etaAt       DateTime?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shipments   Shipment[]
}

/// Status: REGISTERED | LOADING | IN_TRANSIT | ARRIVED | READY | DELIVERED
model Shipment {
  id            String          @id @default(cuid())
  trackingId    String          @unique
  description   String
  mode          String
  status        String          @default("REGISTERED")
  pieces        Int             @default(1)
  weightKg      Float
  volumeCbm     Float
  priceXof      Int
  clientName    String
  clientPhone   String
  clientEmail   String?
  containerId   String?
  container     Container?      @relation(fields: [containerId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User            @relation("CreatedShipments", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  events        ShipmentEvent[]
  photos        Photo[]
  notifications Notification[]

  @@index([clientPhone])
  @@index([clientEmail])
  @@index([status])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

model Photo {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fileName   String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

/// Channel: WHATSAPP — Status: PENDING | SENT | SIMULATED | FAILED
/// `step` is the shipment status the alert announces (one alert per step, see lib/whatsapp.ts).
model Notification {
  id                String    @id @default(cuid())
  shipmentId        String
  shipment          Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  channel           String    @default("WHATSAPP")
  step              String?
  to                String
  body              String
  status            String
  error             String?
  attempts          Int       @default(0)
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([shipmentId, step])
}

/// Request counters for rate limiting, shared by every API instance (serverless-safe).
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}
