# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of front-end origins allowed by CORS (only needed when the SPA is served from another origin)
CORS_ORIGINS=http://localhost:5173
# Set to the number of reverse proxies in front of the API (needed for correct per-IP rate limiting)
TRUST_PROXY=0

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Security ---
# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Forced to true when NODE_ENV=production (cookies are then __Host-jwt / __Host-rt / __Host-csrf).
# Set true locally too if you test over https://localhost.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5

# --- WhatsApp (Twilio). Leave empty to simulate messages (logged + stored) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
