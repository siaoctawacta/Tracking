# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of front-end origins allowed by CORS (only needed when the SPA is served from another origin)
CORS_ORIGINS=http://localhost:5173
# Set to the number of reverse proxies in front of the API (needed for correct per-IP rate limiting)
TRUST_PROXY=0

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Security ---
# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Forced to true when NODE_ENV=production (cookies are then __Host-jwt / __Host-rt / __Host-csrf).
# Set true locally too if you test over https://localhost.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5

# --- Site public (liens de suivi dans les messages WhatsApp) ---
PUBLIC_WEB_URL=http://localhost:5173

# --- WhatsApp ---
# twilio | meta | simulated. Vide = détection automatique selon les identifiants ci-dessous ;
# sans identifiants, les messages sont simulés (journalisés et visibles dans le back-office).
WHATSAPP_PROVIDER=
# Option 1 — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Modèles approuvés (Content API) par étape, ex : {"REGISTERED":"HX...","READY":"HX..."}
TWILIO_CONTENT_SIDS=
# Option 2 — Meta WhatsApp Business Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Modèles nommés <prefixe><etape> : kader_registered, kader_loading, … (vide = texte libre, fenêtre 24 h)
META_TEMPLATE_PREFIX=kader_
META_TEMPLATE_LANGUAGE=fr
