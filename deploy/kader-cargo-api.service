# Service systemd de l'API Kader Cargo.
# Copier vers /etc/systemd/system/, puis : systemctl daemon-reload && systemctl enable --now kader-cargo-api
[Unit]
Description=Kader Cargo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kader
Group=kader
WorkingDirectory=/srv/kader-cargo/api
ExecStart=/usr/bin/node --env-file=.env --import tsx src/server.ts
Restart=always
RestartSec=5

# Durcissement : l'API ne peut écrire que dans /var/lib/kader-cargo (base + photos).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kader-cargo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
