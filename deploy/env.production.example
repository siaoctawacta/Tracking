# /srv/kader-cargo/server/.env — configuration de production (propriétaire root:kader, droits 640)
NODE_ENV=production
PORT=4000
# Nombre de proxys devant l’API : 1 avec Caddy seul, 2 si le site est sur Vercel (Vercel puis Caddy)
TRUST_PROXY=1

# Base PostgreSQL — Supabase (bouton « Connect ») ou un Postgres installé sur le serveur.
#   DATABASE_URL = « Transaction pooler » (port 6543) · DIRECT_URL = « Session pooler » (port 5432, migrations)
DATABASE_URL=
DIRECT_URL=
# SSL : vide = automatique (chiffré pour Supabase) · verify = avec DATABASE_CA_CERT (certificat Supabase)
DATABASE_SSL=
DATABASE_CA_CERT=

# Photos : sur le disque du serveur (UPLOAD_DIR) ou dans Supabase Storage (SUPABASE_URL + clé service_role)
UPLOAD_DIR=/var/lib/kader-cargo/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# Secret de signature des sessions — à générer UNE fois :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
LOGIN_RATE_LIMIT=5

# Adresse publique du site (liens de suivi dans les messages WhatsApp et e-mails)
PUBLIC_WEB_URL=https://kadercargo.com

# --- WhatsApp : Twilio OU Meta (voir docs/whatsapp-alertes.md) ---
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SIDS=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_TEMPLATE_PREFIX=kader_
META_TEMPLATE_LANGUAGE=fr

# --- E-mail (codes de vérification) — Gmail : mot de passe d'application ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kader Cargo <votre-adresse@gmail.com>"

# --- Connexion Google (facultatif) ---
GOOGLE_CLIENT_ID=
