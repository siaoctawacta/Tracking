# /srv/kader-cargo/server/.env — configuration de production (propriétaire root:kader, droits 640)
NODE_ENV=production
PORT=4000
# Nombre de proxys devant l’API : 1 avec Caddy seul, 2 si le site est sur Vercel (Vercel puis Caddy)
TRUST_PROXY=1

# Données (hors du dossier du code)
DATABASE_URL="file:/var/lib/kader-cargo/kader.db"
UPLOAD_DIR=/var/lib/kader-cargo/uploads

# Secret de signature des sessions — à générer UNE fois :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
LOGIN_RATE_LIMIT=5

# Adresse publique du site (liens de suivi dans les messages WhatsApp et e-mails)
PUBLIC_WEB_URL=https://kadercargo.com

# --- WhatsApp : Twilio OU Meta (voir docs/whatsapp-alertes.md) ---
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SIDS=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_TEMPLATE_PREFIX=kader_
META_TEMPLATE_LANGUAGE=fr

# --- E-mail (codes de vérification) — Gmail : mot de passe d'application ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kader Cargo <votre-adresse@gmail.com>"

# --- Connexion Google (facultatif) ---
GOOGLE_CLIENT_ID=
