# Security headers for the SPA when served from a CDN (Netlify / Cloudflare Pages syntax).
# Replace https://api.kadercargo.com with the real API origin (or drop it if the API is proxied under /api).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' https://api.kadercargo.com https://accounts.google.com/gsi/; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), identity-credentials-get=(self "https://accounts.google.com")

/assets/*
  Cache-Control: public, max-age=31536000, immutable
