# Security headers for the SPA when served from a CDN (Netlify / Cloudflare Pages syntax).
# Replace https://api.benitcargo.com with the real API origin (or drop it if the API is proxied under /api).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' https://api.benitcargo.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
